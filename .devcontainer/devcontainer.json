{
  "name": "RetainIQ",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",
  "postCreateCommand": "python -m pip install --upgrade pip && pip install -e '.[dev]' && python -m RetainIQ.training",
  "postStartCommand": "nohup uvicorn RetainIQ.main:app --host 0.0.0.0 --port 8000 > /tmp/RetainIQ.log 2>&1 &",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "RetainIQ",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"]
    }
  }
}
